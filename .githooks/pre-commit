#!/usr/bin/env bash
# Stamps the app version (derived from git) into the sheet on every commit, so the
# app always knows which build it is, Save/Update downloads are version-named, and
# the service-worker cache busts on each deploy.
#
#   APP_VERSION in index.html  ->  "v<N> (YYYY-MM-DD)"   N = this commit's number (monotonic build id, drives update comparison)
#   APP_SEMVER  in index.html  ->  "<X.Y.Z>"             read from the VERSION file (human-facing SemVer, curated by hand)
#   CACHE       in sw.js       ->  "dnd-sheet-v<N>"      (same N; drops the old cache)
#   version.json               ->  {"version":"v<N> (date)","semver":"<X.Y.Z>"}   (probe the update banner polls)
#
# Bump the SemVer by editing the VERSION file: PATCH for fixes, MINOR for features, MAJOR for big changes.
#
# Best-effort: never block a commit. Activate in a fresh clone with:
#   git config core.hooksPath .githooks
set -u

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" || exit 0

# This commit's sequence number = existing commits + 1 (0 commits -> v1).
have="$(git rev-list --count HEAD 2>/dev/null || echo 0)"
num=$((have + 1))
date="$(date +%Y-%m-%d)"
ver="v${num} (${date})"

# Human-facing SemVer, curated in the VERSION file (default 0.0.0 if absent/blank).
semver="$(tr -d '[:space:]' < VERSION 2>/dev/null)"
[ -z "$semver" ] && semver="0.0.0"

# Stamp APP_VERSION on the line carrying the @APP_VERSION@ marker (idempotent).
if grep -q '@APP_VERSION@' index.html 2>/dev/null; then
  ver="$ver" perl -i -pe 's/(const APP_VERSION = ")[^"]*(";)/$1$ENV{ver}$2/ if /\@APP_VERSION\@/' index.html \
    && git add index.html \
    && echo "pre-commit: stamped APP_VERSION = $ver"
fi

# Stamp APP_SEMVER (the human-facing version) from the VERSION file.
if grep -q '@APP_SEMVER@' index.html 2>/dev/null; then
  semver="$semver" perl -i -pe 's/(const APP_SEMVER = ")[^"]*(";)/$1$ENV{semver}$2/ if /\@APP_SEMVER\@/' index.html \
    && git add index.html \
    && echo "pre-commit: stamped APP_SEMVER = $semver"
fi

# Stamp the pending "Unreleased" changelog entry with this version (Keep-a-Changelog style), so the
# welcome guide's notes always carry the right vN automatically — same N as APP_VERSION. A commit with
# no Unreleased entry (no user-facing notes) is left untouched.
if grep -q '{v:"Unreleased"' index.html 2>/dev/null; then
  num="$num" semver="$semver" perl -i -pe 's/\{v:"Unreleased"/{v:"v$ENV{num}", semver:"$ENV{semver}"/ if /\{v:"Unreleased"/' index.html \
    && git add index.html \
    && echo "pre-commit: stamped CHANGELOG Unreleased -> v$num ($semver)"
fi

# Write the tiny version probe the in-app "update available" banner polls, so it can detect a
# newer build without downloading the multi-MB index.html. Carries the build id (for comparison,
# back-compatible with older clients) plus the SemVer (for display on newer clients).
# Optional "critical update" flag: if update-note.txt exists and is non-empty, version.json carries
# {critical:true, note:"<its text>"} so the in-app banner shows it prominently and keeps resurfacing
# until the user updates (clients on a build that predates this feature simply ignore the extra fields).
# TARGET IT: make the FIRST line "<=X.Y.Z" (the newest affected SemVer) and it becomes criticalMax, so only
# builds at or below that version see the urgent banner; anyone past it gets the ordinary update banner.
# Without that line the note hits every older build, which is rarely what you want.
# STICKY: the note rides every release until you delete update-note.txt — remove it once the urgency passes.
if [ -f version.json ]; then
  # True UNCOMPRESSED byte size of index.html (measured after the stamps above land). The app uses this as the
  # download denominator so the update progress bar shows a real % — GitHub Pages serves the file gzipped, so the
  # response's content-length is the compressed size and can't drive an honest bar.
  size="$(wc -c < index.html 2>/dev/null | tr -d '[:space:]')"
  [ -z "$size" ] && size=0
  raw=""
  [ -f update-note.txt ] && raw="$(cat update-note.txt)"
  if [ -n "$(printf '%s' "$raw" | tr -d '[:space:]')" ] && command -v python3 >/dev/null 2>&1; then
    ver="$ver" semver="$semver" size="$size" raw="$raw" python3 - <<'PYNOTE'
import json, os, re
lines = os.environ["raw"].replace("\r", "").split("\n")
cap = ""
m = re.match(r"^\s*<=?\s*(\d+\.\d+\.\d+)\s*$", lines[0]) if lines else None
if m:                                  # first line is a "<=X.Y.Z" ceiling, not part of the message
    cap, lines = m.group(1), lines[1:]
note = re.sub(r"\s+", " ", " ".join(lines)).strip()
out = {"version": os.environ["ver"], "semver": os.environ["semver"], "size": int(os.environ["size"])}
if note:
    out["critical"] = True
    out["note"] = note
    if cap:
        out["criticalMax"] = cap
with open("version.json", "w") as f:
    f.write(json.dumps(out) + "\n")
print("pre-commit: wrote version.json = %s / %s (size %s, CRITICAL%s: %s)"
      % (out["version"], out["semver"], out["size"], " for <=" + cap if cap else " for ALL older builds", note))
PYNOTE
    git add version.json
  else
    printf '{"version":"%s","semver":"%s","size":%s}\n' "$ver" "$semver" "$size" > version.json \
      && git add version.json \
      && echo "pre-commit: wrote version.json = $ver / $semver (size $size)"
  fi
fi

# Tie the service-worker cache to the same version so each deploy busts the offline
# cache and fresh content lands on the next load (no "reload twice").
if [ -f sw.js ]; then
  num="$num" perl -i -pe 's/(const CACHE = "dnd-sheet-)v\d+(";)/$1v$ENV{num}$2/' sw.js \
    && git add sw.js \
    && echo "pre-commit: stamped SW CACHE = dnd-sheet-v$num"
fi

exit 0
